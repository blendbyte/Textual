# macOS
.DS_Store
.LSOverride

# Editor backups
*~
*~.*

# Xcode per-user state
xcuserdata/

# Workspaces Xcode creates inside a project opened on its own. The
# top-level Textual.xcworkspace is tracked in full, so shared settings
# (e.g. a Package.resolved) get committed.
**/*.xcodeproj/project.xcworkspace/

# Local code signing overrides
/Configurations/Build/Signing.local.xcconfig

# Build output
/.tmp/
/Build Results/

# Intermediates of the nested xcodebuild calls in the build scripts
/Sources/App/build/
/Sources/Plugins/**/build/

