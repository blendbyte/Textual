#!/bin/bash
#
# Build, run and test "Textual Dev", the Debug build of Textual.
#
# Textual Dev has its own bundle identifier (com.textualapp.app.dev) and
# app group, so it never shares a container, preferences or logs with an
# installed copy of Textual. For testing, it connects to IRC servers on
# this Mac only (see "server" and "scripted" below).
#
# "vm-bundle" packs Textual Dev, Ergo, the scripted server and a standalone
# Python into a folder shared with a test VM; there, TextualTest/vm-dev runs
# the same commands (except build and screenshot) against copies in the VM.
#
# Run "Development/dev help" for the commands.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP="${TEXTUAL_DEV_APP:-${ROOT}/Build Results/Debug/Textual.app}"
DATA="${ROOT}/.tmp/dev"

BUNDLE_ID="com.textualapp.app.dev"
GROUP_ID="FANJ7JNLP5.com.textualapp.app.dev"

ERGO_VERSION="2.19.1"
ERGO_SHA256_ARM64="1bd97a0917036061e2dcdfc29149c2e252e3bc856282e0956afa2aaaa54dd787"
ERGO_SHA256_X86_64="68b388a49034257082ee0292703874630a2c10cfba86c73bb2adc37b515c57a3"
ERGO_DIR="${DATA}/ergo"

# Standalone Python for the VM, which has no developer tools (python-build-standalone)
PYTHON_RELEASE="20261003"
PYTHON_VERSION="3.13.16"
PYTHON_SHA256_ARM64="d8975d7df4f08f7b1c7aafcdfacbddcec3d366415f2c1a72b2466b6850815933"
PYTHON_SHA256_X86_64="8e9cb087305bfb8969f68a905f79f41469d4aa5220c1aa71ada7fc9953bdba0f"

# Folder shared with the test VM (VMPal shares ~/Downloads)
VM_SHARE="${TEXTUAL_VM_SHARE:-${HOME}/Downloads/textual-vm}"

# Textual Dev accepts textual://dev-… actions only with the token it was started with
TOKEN_FILE="${DATA}/launch-token"

die() { echo "dev: $*" >&2; exit 1; }

# For pgrep patterns: the checkout path may contain regular expression characters
regex_escape() { printf '%s' "$1" | sed 's/[][\\.*^$(){}?+|/]/\\&/g'; }

app_pid() { pgrep -f "^$(regex_escape "${APP}")/Contents/MacOS/Textual" || true; }

# Runs a textual://dev-… action (the URL already has a query) in the running Textual Dev
open_dev_url() {
	[ -n "$(app_pid)" ] && [ -f "${TOKEN_FILE}" ] ||
		die "Textual Dev is not running, or wasn't started with Development/dev start (its actions need the launch token)"

	open -a "${APP}" "$1&token=$(cat "${TOKEN_FILE}")"
}

check_app() {
	[ -d "${APP}" ] || die "Textual Dev is not built yet. Run: Development/dev build"

	local identifier
	identifier=$(/usr/libexec/PlistBuddy -c "Print CFBundleIdentifier" "${APP}/Contents/Info.plist")

	# Never launch a build that could share data with an installed Textual
	[ "${identifier}" = "${BUNDLE_ID}" ] || die "${APP} has identifier ${identifier}, expected ${BUNDLE_ID}"
}

cmd_build() {
	cd "${ROOT}"

	xcodebuild -workspace Textual.xcworkspace -scheme "Textual (Debug)" build 2>&1 |
		grep -E "error:|\*\* BUILD" | sort -u

	check_app
}

cmd_start() {
	check_app

	if [ -n "$(app_pid)" ]; then
		echo "Textual Dev is already running."
		return
	fi

	mkdir -p "${DATA}"

	local token
	token=$(uuidgen)

	(umask 077 && printf '%s' "${token}" > "${TOKEN_FILE}")

	# Further arguments become launch arguments, e.g. "-PreferModernSockets" NO
	# overrides that preference until the next start.
	open "${APP}" --args -TextualDevToken "${token}" "$@"

	for _ in $(seq 1 20); do
		[ -n "$(app_pid)" ] && return 0
		sleep 0.5
	done
}

cmd_stop() {
	[ -n "$(app_pid)" ] || return 0

	osascript -e "tell application id \"${BUNDLE_ID}\" to quit" > /dev/null 2>&1 || true

	for _ in $(seq 1 20); do
		[ -n "$(app_pid)" ] || return 0
		sleep 0.5
	done

	echo "Textual Dev did not quit; terminating it."
	kill -TERM $(app_pid) 2> /dev/null || true
}

cmd_run() {
	cmd_build
	cmd_stop
	cmd_start
}

cmd_reset() {
	check_app

	echo "This deletes Textual Dev's server list, preferences, scrollback, caches, logs and scripts."

	if [ "${1:-}" != "--yes" ]; then
		read -r -p "Continue? [y/N] " answer
		[ "${answer}" = "y" ] || [ "${answer}" = "Y" ] || exit 1
	fi

	# macOS lets only the app itself empty its containers, so Textual Dev
	# deletes its own data (textual://dev-reset) and quits without saving.
	cmd_stop
	cmd_start > /dev/null

	sleep 3

	open_dev_url "textual://dev-reset?confirm=1"

	for _ in $(seq 1 20); do
		[ -n "$(app_pid)" ] || break
		sleep 0.5
	done

	[ -z "$(app_pid)" ] || die "Textual Dev did not reset; is it a build with textual://dev-reset?"

	rm -rf "${HOME}/Library/Application Scripts/${BUNDLE_ID}" \
		"${HOME}/Library/Saved Application State/${BUNDLE_ID}.savedState"

	echo "Textual Dev was reset. Its Keychain items (\"Textual (…)\") are kept."
}

cmd_logs() {
	log stream --style compact --level debug \
		--predicate "processImagePath BEGINSWITH \"${APP}/\""
}

ergo_install() {
	[ -x "${ERGO_DIR}/ergo" ] && return

	# Installed in a separate folder that only becomes ERGO_DIR when complete,
	# so a failed step doesn't leave a half-installed server behind
	local staging="${ERGO_DIR}.partial"

	rm -rf "${staging}"

	local arch sha
	case "$(uname -m)" in
		arm64) arch="arm64"; sha="${ERGO_SHA256_ARM64}" ;;
		*) arch="x86_64"; sha="${ERGO_SHA256_X86_64}" ;;
	esac

	local name="ergo-${ERGO_VERSION}-macos-${arch}"
	local download="${DATA}/download"

	mkdir -p "${download}"

	echo "Downloading Ergo ${ERGO_VERSION}…"
	curl -fsSL -o "${download}/${name}.tar.gz" \
		"https://github.com/ergochat/ergo/releases/download/v${ERGO_VERSION}/${name}.tar.gz"

	echo "${sha}  ${download}/${name}.tar.gz" | shasum -a 256 -c - > /dev/null ||
		die "Ergo download does not match its checksum"

	tar -xzf "${download}/${name}.tar.gz" -C "${download}"
	mkdir -p "${staging}"
	cp -R "${download}/${name}/." "${staging}/"
	rm -rf "${download}"

	python3 "${ROOT}/Development/ergo-config.py" "${staging}/default.yaml" "${staging}/ircd.yaml"

	(cd "${staging}" && ./ergo mkcerts --conf ircd.yaml --quiet && ./ergo initdb --conf ircd.yaml --quiet)

	mv "${staging}" "${ERGO_DIR}"
}

ergo_pid() { pgrep -f "^$(regex_escape "${ERGO_DIR}")/ergo run" || true; }

cmd_server() {
	case "${1:-start}" in
		start)
			ergo_install

			if [ -n "$(ergo_pid)" ]; then
				echo "Ergo is already running."
			else
				(cd "${ERGO_DIR}" && nohup "${ERGO_DIR}/ergo" run --conf ircd.yaml > "${DATA}/ergo.log" 2>&1 &)
				sleep 1
				[ -n "$(ergo_pid)" ] || die "Ergo did not start; see ${DATA}/ergo.log"
			fi

			echo "Ergo: 127.0.0.1 port 6667 (plain) and 6697 (TLS, self-signed); NickServ host services.textual.test"
			;;
		stop)
			[ -z "$(ergo_pid)" ] || kill $(ergo_pid)
			;;
		status)
			if [ -n "$(ergo_pid)" ]; then echo "Ergo is running."; else echo "Ergo is not running."; fi
			;;
		*)
			die "server takes start, stop or status"
			;;
	esac
}

cmd_scripted() {
	exec python3 "${ROOT}/Development/scripted-irc-server.py" "$@"
}

python_download() {
	local arch sha
	case "$(uname -m)" in
		arm64) arch="aarch64"; sha="${PYTHON_SHA256_ARM64}" ;;
		*) arch="x86_64"; sha="${PYTHON_SHA256_X86_64}" ;;
	esac

	local name="cpython-${PYTHON_VERSION}+${PYTHON_RELEASE}-${arch}-apple-darwin-install_only.tar.gz"
	local archive="${DATA}/${name}"

	if [ ! -f "${archive}" ]; then
		echo "Downloading Python ${PYTHON_VERSION} for the VM…" >&2
		curl -fsSL -o "${archive}.partial" \
			"https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_RELEASE}/${name//+/%2B}"
		echo "${sha}  ${archive}.partial" | shasum -a 256 -c --quiet - || { rm -f "${archive}.partial"; die "Python checksum mismatch"; }
		mv "${archive}.partial" "${archive}"
	fi

	printf '%s' "${archive}"
}

cmd_vm-bundle() {
	check_app
	ergo_install
	mkdir -p "${DATA}"

	local python_archive
	python_archive=$(python_download)

	local staging
	staging=$(mktemp -d)
	# Expanded now: the trap runs after this function's locals are gone
	trap "rm -rf '${staging}'" EXIT

	local bundle="${staging}/TextualTest"
	mkdir -p "${bundle}/Development" "${bundle}/.tmp/dev"

	cp "${ROOT}/Development/dev" "${ROOT}/Development/scripted-irc-server.py" "${ROOT}/Development/ergo-config.py" "${bundle}/Development/"
	# Without the database and lock of the Ergo running here; vm-dev creates its own
	rsync -a --exclude ircd.db --exclude ircd.lock "${ERGO_DIR}/" "${bundle}/.tmp/dev/ergo/"
	tar -xzf "${python_archive}" -C "${bundle}"
	ditto "${APP}" "${bundle}/Textual.app"

	cat > "${bundle}/vm-dev" <<-'GUEST'
	#!/bin/sh
	# Development/dev inside the test VM: Textual Dev, Ergo and the scripted
	# server from this folder, with the bundled Python. The servers run as
	# launchd jobs, so they outlive the command that started them (an agent's
	# remote command ends every process it started when it returns).
	here="$(cd "$(dirname "$0")" && pwd)"
	export PATH="${here}/python/bin:${PATH}"
	export TEXTUAL_DEV_APP="${here}/Textual.app"
	data="${here}/.tmp/dev"
	ergo="${data}/ergo"
	domain="gui/$(id -u)"
	[ -f "${ergo}/ircd.db" ] || (cd "${ergo}" && ./ergo initdb --conf ircd.yaml --quiet)

	# job <name> <working directory> <program> [arguments…]
	job() {
		name="$1" directory="$2"; shift 2
		label="com.textualapp.app.dev.vm.${name}"
		plist="${data}/${label}.plist"
		launchctl bootout "${domain}/${label}" 2> /dev/null
		rm -f "${plist}"
		plutil -create xml1 "${plist}"
		plutil -insert Label -string "${label}" "${plist}"
		plutil -insert WorkingDirectory -string "${directory}" "${plist}"
		plutil -insert RunAtLoad -bool true "${plist}"
		plutil -insert StandardOutPath -string "${data}/${name}.log" "${plist}"
		plutil -insert StandardErrorPath -string "${data}/${name}.log" "${plist}"
		plutil -insert EnvironmentVariables -json "{\"PATH\": \"${PATH}\"}" "${plist}"
		plutil -insert ProgramArguments -json '[]' "${plist}"
		for argument in "$@"; do
			plutil -insert ProgramArguments -string "${argument}" -append "${plist}"
		done
		: > "${data}/${name}.log"
		launchctl bootstrap "${domain}" "${plist}"
	}

	case "$1" in
		server)
			case "${2:-start}" in
				start) job ergo "${ergo}" "${ergo}/ergo" run --conf ircd.yaml; sleep 1; exec "${here}/Development/dev" server status ;;
				stop) launchctl bootout "${domain}/com.textualapp.app.dev.vm.ergo" 2> /dev/null; exit 0 ;;
			esac ;;
		scripted)
			shift
			case "${1:-}" in
				stop) launchctl bootout "${domain}/com.textualapp.app.dev.vm.scripted" 2> /dev/null; exit 0 ;;
				log) exec cat "${data}/scripted.log" ;;
				""|--list|--help|-h) ;;
				*) job scripted "${here}" "${here}/python/bin/python3" -u "${here}/Development/scripted-irc-server.py" "$@"; sleep 1; exec cat "${data}/scripted.log" ;;
			esac
			set -- scripted "$@" ;;
	esac

	exec "${here}/Development/dev" "$@"
	GUEST
	chmod +x "${bundle}/vm-dev"

	mkdir -p "${VM_SHARE}"
	tar -czf "${VM_SHARE}/TextualTest.tar.gz.partial" -C "${staging}" TextualTest
	mv "${VM_SHARE}/TextualTest.tar.gz.partial" "${VM_SHARE}/TextualTest.tar.gz"

	echo "Bundle: ${VM_SHARE}/TextualTest.tar.gz"
	echo "In the VM: tar -xzf <share>/textual-vm/TextualTest.tar.gz -C ~ && ~/TextualTest/vm-dev server start"
	echo "(vm-dev scripted <scenario> runs in the background; vm-dev scripted log / stop)"
}

cmd_connect() {
	check_app

	[ -n "$(app_pid)" ] || cmd_start > /dev/null

	local url
	url=$(python3 -c 'import sys, urllib.parse
print("textual://dev-connect?" + urllib.parse.urlencode({"url": sys.argv[1]}, quote_via=urllib.parse.quote))' "${1:-irc://127.0.0.1:6667/#textual-dev}")

	open_dev_url "${url}"
}

cmd_input() {
	check_app

	local channel=""

	if [ "${1:-}" = "--channel" ]; then
		channel="$2"
		shift 2
	fi

	[ $# -gt 0 ] || die "input needs the text to run (or '' to only select), e.g. Development/dev input /brag"

	local url
	url=$(python3 -c 'import sys, urllib.parse
query = {"text": sys.argv[1]}
if sys.argv[2]:
	query["channel"] = sys.argv[2]
print("textual://dev-input?" + urllib.parse.urlencode(query, quote_via=urllib.parse.quote))' "$*" "${channel}")

	open_dev_url "${url}"
}

cmd_config() {
	check_app

	[ $# -gt 0 ] || die "config needs key=value pairs, e.g. Development/dev config nickServHost=services.textual.test"

	local url
	url=$(python3 -c 'import sys, urllib.parse
pairs = [tuple(argument.split("=", 1)) for argument in sys.argv[1:]]
print("textual://dev-config?" + urllib.parse.urlencode(pairs, quote_via=urllib.parse.quote))' "$@")

	open_dev_url "${url}"
}

cmd_send() {
	check_app

	# The sandbox opens only files Textual Dev saved itself (or the user picked):
	# a file another app created in ~/Downloads blocks the transfer.
	[ $# -eq 2 ] || die "send needs a nickname and a file Textual Dev saved in ~/Downloads, e.g. Development/dev send alice ~/Downloads/received.txt"

	local url
	url=$(python3 -c 'import sys, urllib.parse
print("textual://dev-send?" + urllib.parse.urlencode({"nickname": sys.argv[1], "path": sys.argv[2]}, quote_via=urllib.parse.quote))' "$1" "$2")

	open_dev_url "${url}"
}

cmd_eval() {
	check_app

	[ $# -eq 1 ] || die "eval needs a script, e.g. Development/dev eval 'document.title'"

	local url
	url=$(python3 -c 'import sys, urllib.parse
print("textual://dev-eval?" + urllib.parse.urlencode({"script": sys.argv[1]}, quote_via=urllib.parse.quote))' "$1")

	open_dev_url "${url}"

	# The result is logged
	sleep 1
	/usr/bin/log show --last 5s --style compact --predicate "processImagePath BEGINSWITH \"${APP}/\" AND eventMessage BEGINSWITH \"dev-eval: \"" |
		sed -n 's/.*dev-eval: //p' | tail -n 1
}

cmd_screenshot() {
	local pid output window
	pid=$(app_pid)
	[ -n "${pid}" ] || die "Textual Dev is not running"

	output="${1:-${DATA}/screenshots/$(date +%Y%m%d-%H%M%S).png}"
	mkdir -p "$(dirname "${output}")"

	# Only Textual Dev's own frontmost window, never the whole screen
	window=$(swift "${ROOT}/Development/window-id.swift" "${pid}" | head -n 1)
	[ -n "${window}" ] || die "Textual Dev has no window on screen"

	screencapture -x -o -l "${window}" "${output}"

	echo "${output}"
}

cmd_help() {
	cat <<-EOF
	Usage: Development/dev <command>

	  build                 Build Textual Dev (the Debug build)
	  run                   Build, quit a running Textual Dev and start it again
	  start [-key value …]  Start Textual Dev, with preferences overridden by launch arguments
	  stop                  Quit Textual Dev
	  reset [--yes]         Delete Textual Dev's settings, logs and scrollback
	  logs                  Stream the log of Textual Dev and its services
	  connect [url]         Connect Textual Dev to a test server on this Mac (an irc:// or
	                        ircs:// URL to 127.0.0.1 or localhost; default: the local Ergo)
	  input [--channel c] <text>
	                        Select the newest server (or its channel c) and run text
	                        there as if typed; '' only selects
	  config key=value …    Change the newest server's configuration (IRCClientConfig
	                        names, e.g. nicknamePassword=… nickServHost=…)
	  eval <script>         Run JavaScript in the selected view and print the result
	  send <nickname> <file>
	                        Offer a file Textual Dev saved in ~/Downloads to a user
	  screenshot [file]     Capture Textual Dev's window
	  server [start|stop|status]
	                        Local Ergo server on 127.0.0.1 (6667, TLS 6697)
	  scripted <scenario>   Scripted server for edge cases (scripted --help)
	  vm-bundle             Pack Textual Dev and the test servers for a test VM, into
	                        \$TEXTUAL_VM_SHARE (default ~/Downloads/textual-vm)
	EOF
}

command="${1:-help}"
shift || true

case "${command}" in
	build|run|start|stop|reset|logs|server|scripted|connect|input|config|send|eval|screenshot|vm-bundle|help) "cmd_${command}" "$@" ;;
	*) cmd_help; exit 1 ;;
esac
