/* The setup window at first launch (TDCSetupAssistant.swift) */
"sa-title" = "Set Up Textual";
"sa-a-step" = "Step %1$ld of %2$ld";

"sa-b-new" = "I’m New to IRC";
"sa-b-know" = "I Know What I Want";
"sa-b-continue" = "Continue";
"sa-b-back" = "Back";
"sa-b-finish" = "Open Textual";

"sa-w-title" = "Welcome to Textual";
"sa-w-lead" = "A chat app for IRC, one of the internet’s oldest and most open ways to talk. A few questions and you’re in a conversation.";
"sa-w-new-t" = "New to IRC?";
"sa-w-new-d" = "We’ll explain how it works in a minute and suggest good places to start, based on what you’re into.";
"sa-w-know-t" = "Know what you want?";
"sa-w-know-d" = "Skip the introduction and go straight to the full list of networks, or your bouncer.";

"sa-h-title" = "How IRC works";
"sa-h-lead" = "Think of it as thousands of public rooms, run by communities instead of one company.";
"sa-h-net-t" = "Networks";
"sa-h-net-d" = "A community that runs chat servers. Each is its own world with its own people and rules. You can be on several at once.";
"sa-h-chan-t" = "Channels";
"sa-h-chan-d" = "The rooms inside a network, usually starting with #. Anyone can join most of them. People talk about one topic.";
"sa-h-ppl-t" = "People";
"sa-h-ppl-d" = "Everyone picks a nickname. You can write to the whole channel, or to one person privately.";
"sa-h-know-t" = "Good to know";
"sa-h-know-d" = "IRC only delivers messages while you’re connected, so you won’t see what was said while you were away. Most channels are public, and messages aren’t end-to-end encrypted. People are usually friendly: lurking first is normal, and a question may take a while to get an answer.";

"sa-d-title" = "You’re all set";
"sa-d-lead" = "Add a server whenever you’re ready. All of this can be changed in Settings.";
