/* The setup window at first launch (TDCSetupAssistant.swift) */
"sa-title" = "Set Up Textual";
"sa-a-step" = "Step %1$ld of %2$ld";

"sa-b-new" = "I’m New to IRC";
"sa-b-know" = "I Know What I Want";
"sa-b-continue" = "Continue";
"sa-b-back" = "Back";
"sa-b-finish" = "Open Textual";

"sa-b-recommended" = "Use Recommended";
"sa-b-keepall" = "Keep Everything";

"sa-w-title" = "Welcome to Textual";
"sa-w-lead" = "A chat app for IRC, one of the internet’s oldest and most open ways to talk. A few questions and you’re in a conversation.";
"sa-w-new-t" = "New to IRC?";
"sa-w-new-d" = "We’ll explain how it works in a minute and suggest good places to start, based on what you’re into.";
"sa-w-know-t" = "Know what you want?";
"sa-w-know-d" = "Skip the introduction and go straight to the full list of networks, or your bouncer.";

"sa-h-title" = "How IRC works";
"sa-h-lead" = "Think of it as thousands of public rooms, run by communities instead of one company.";
"sa-h-net-t" = "Networks";
"sa-h-net-d" = "A community that runs chat servers. Each is its own world with its own people and rules. You can be on several at once.";
"sa-h-chan-t" = "Channels";
"sa-h-chan-d" = "The rooms inside a network, usually starting with #. Anyone can join most of them. People talk about one topic.";
"sa-h-ppl-t" = "People";
"sa-h-ppl-d" = "Everyone picks a nickname. You can write to the whole channel, or to one person privately.";
"sa-h-know-t" = "Good to know";
"sa-h-know-d" = "IRC only delivers messages while you’re connected, so you won’t see what was said while you were away. Most channels are public, and messages aren’t end-to-end encrypted. People are usually friendly: lurking first is normal, and a question may take a while to get an answer.";

"sa-y-title" = "Choose a style";
"sa-y-lead" = "A style sets the colors and layout of the chat. You can switch any time in Settings › Appearance.";
"sa-y-lead-u" = "Textual 8 comes with Lumen, a new style we’d suggest trying. Yours stays unless you pick another, and you can switch any time in Settings › Appearance.";
"sa-y-rec" = "Recommended";
"sa-y-yours" = "Yours";

"sa-l-title" = "How messages appear";
"sa-l-lead" = "How the chat reads, and how this window and Textual look. Fonts are in Settings › Appearance.";
"sa-l-chat" = "Chat";
"sa-l-chat-d" = "Names sit above the messages, like most chat apps today.";
"sa-l-classic" = "Classic";
"sa-l-classic-d" = "A time and name on every line. Fits more on screen.";
"sa-l-classic-only" = "This style only has the Classic display: a name on every line.";
"sa-l-ap-t" = "Appearance";
"sa-l-ap-d" = "Like the Mac follows your Mac, switching at night if it’s set to.";
"sa-l-size-t" = "Text size";
"sa-l-size-d" = "The size of messages in the chat.";
"sa-l-s12" = "Small";
"sa-l-s13" = "Standard";
"sa-l-s15" = "Large";
"sa-l-s17" = "Larger";
"sa-l-sother" = "%ld points";
"sa-l-sp-t" = "Message spacing";
"sa-l-sp-d" = "How close the lines sit. Compact fits more, Roomy is easier to read.";
"sa-l-sp0" = "Compact";
"sa-l-sp1" = "Standard";
"sa-l-sp2" = "Roomy";

"sa-v-on" = "On";
"sa-v-off" = "Off";
"sa-v-new" = "NEW";
"sa-v-was" = "In Textual 7: %@";

"sa-c-title" = "In the conversation";
"sa-c-lead" = "How busy channels read, and what helps while you type. Click a row to see what it does.";
"sa-c-ev-t" = "Joins, parts and quits";
"sa-c-ev-d" = "People entering and leaving a channel";
"sa-c-ev0" = "Show";
"sa-c-ev1" = "Collapse";
"sa-c-ev2" = "Hide";
"sa-c-ev-x1" = "On IRC, people connect and disconnect all day, and each one is normally announced. In a busy channel these lines can outnumber the conversation.";
"sa-c-ev-x2" = "Collapse folds them into one quiet line you can open. Hide removes them, so you won’t see who just left. Show gives each its own line.";
"sa-c-ev-sample" = "1 joined, 2 left ›";
"sa-c-sug-t" = "Suggestions while typing";
"sa-c-sug-d" = "A small list as you type a name or command";
"sa-c-sug-x1" = "Type @ for people, # for channels, / for commands and : for emoji, and Textual lists what fits. It saves remembering exact spellings, which matters on IRC, where names are often odd.";
"sa-c-sug-off" = "No list appears. The Tab key still completes names.";
"sa-c-md-t" = "Markdown when sending";
"sa-c-md-d" = "Simple marks become bold or italic";
"sa-c-md-x1" = "If you’ve used Slack or Discord, it’s the same marks. Textual turns them into IRC’s own formatting, so people on other apps see bold too.";
"sa-c-md-x2" = "Turn it off if you often post code or text with stars and underscores in it.";
"sa-c-md-you" = "You type";
"sa-c-md-see" = "People see";
"sa-c-inp-t" = "Where you type";
"sa-c-inp-d" = "The width of the message field";
"sa-c-inp0" = "Whole window";
"sa-c-inp1" = "Chat only";
"sa-c-inp-x1" = "Whole window runs the message field across the bottom, for long lines. Chat only keeps it under the conversation, so the server and member lists reach the bottom of the window.";
"sa-c-arr-t" = "Two channels at once";
"sa-c-arr-d" = "Select two in the list to see both";
"sa-c-arr0" = "Stacked";
"sa-c-arr1" = "Side by side";
"sa-c-arr-x1" = "Select two channels in the server list and Textual shows them together. This decides how they’re arranged. Most people never need it, so the default is fine.";

"sa-p-title" = "What Textual fetches and keeps";
"sa-p-lead" = "Most of Textual stays between you and the network. These are the choices where something else is involved.";
"sa-p-prev-t" = "Link previews";
"sa-p-prev-d" = "Pictures and videos from links in the chat";
"sa-p-prev-x1" = "Worth knowing: to show a preview, Textual fetches the link. That site sees your IP address, even if you never click, so it can tell roughly where you are.";
"sa-p-prev-x2" = "On IRC, anyone can post a link. If that bothers you, leave this off and links stay plain text.";
"sa-p-card-t" = "Cards for other web pages";
"sa-p-card-d" = "A title and summary for any page";
"sa-p-card-x1" = "Without this, previews only appear for pictures and videos. With it, a link to any article shows its title and summary. Each one also contacts the linked site.";
"sa-p-card-s1" = "A headline from that page";
"sa-p-card-s2" = "The page’s summary, in a line or two";
"sa-p-arc-t" = "Keep messages for search";
"sa-p-arc-d" = "Stored on this Mac only";
"sa-p-arc-x1" = "IRC itself doesn’t remember anything: if you weren’t connected, you won’t see what was said. Textual can keep what it receives, so you can find it later with Search (⌘F) and Mentions (⌃5). It never leaves your Mac.";
"sa-p-arc-off" = "Search only covers what’s on screen.";
"sa-p-arc-s1" = "that link about sourdough";
"sa-p-arc-s2" = "#cooking · March 3";
"sa-p-arc-s3" = "alice: that link about sourdough…";
"sa-p-upd-t" = "Software updates";
"sa-p-upd-d" = "How new versions reach you";
"sa-p-upd-x1" = "Updates bring fixes, including security fixes, so we recommend at least being told. Textual asks our update server whether there’s a newer version. Your chats are never part of that.";
"sa-p-upd-s" = "Textual 8.1 is available";
"sa-p-upd-s2" = "Nothing happens by itself";
"sa-p-upd-s0d" = "It downloads quietly and installs when you quit.";
"sa-p-upd-s1d" = "You see this note and choose when to install.";
"sa-p-upd-s2d" = "Use Check for Updates in the Textual menu when you want to.";

"sa-d-title" = "You’re all set";
"sa-d-lead" = "Add a server whenever you’re ready. All of this can be changed in Settings.";
"sa-d-lead-u" = "Everything’s where you left it. All of this can be changed in Settings.";
