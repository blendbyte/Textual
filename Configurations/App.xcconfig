// The app target (and its unit tests). Set on the targets, so it overrides
// the configuration files set on the project.

#include "Version.xcconfig"

TEXTUAL_WORKSPACE_DIR = ${PROJECT_DIR}/..

HEADER_SEARCH_PATHS = "${TEXTUAL_GENERATED_DIR}/Build Headers/"
FRAMEWORK_SEARCH_PATHS = "${TEXTUAL_WORKSPACE_DIR}/Frameworks/Vendor/Sparkle"

PRODUCT_BUNDLE_IDENTIFIER = ${TEXTUAL_BUNDLE_IDENTIFIER}

PRODUCT_NAME = ${TEXTUAL_PRODUCT_NAME}

WRAPPER_EXTENSION = app

PRODUCT_MODULE_NAME = Textual


GCC_PREFIX_HEADER = ${PROJECT_DIR}/Supporting Files/TextualPrivate.h

SWIFT_OBJC_BRIDGING_HEADER = ${PROJECT_DIR}/Supporting Files/SwiftBridgingHeaderPrivate.h


REMOVE_HEADERS_FROM_EMBEDDED_BUNDLES = NO

INFOPLIST_FILE = ${PROJECT_DIR}/Supporting Files/Info.plist

// Info.plist is run through the preprocessor so that builds without Sparkle
// (Debug, App Store) carry none of its SU* settings.
INFOPLIST_PREPROCESS = YES
INFOPLIST_PREPROCESSOR_DEFINITIONS = TEXTUAL_BUILT_WITH_SPARKLE_ENABLED=$(TEXTUAL_BUILT_WITH_SPARKLE_ENABLED:default=0)
// Traditional mode, so the // in URLs doesn't start a comment
INFOPLIST_OTHER_PREPROCESSOR_FLAGS = -traditional

// Debug builds show as "Textual Dev" so they can't be mistaken for an
// installed copy of Textual (they also have their own identifier).
TEXTUAL_BUNDLE_NAME = ${PRODUCT_NAME}
TEXTUAL_BUNDLE_NAME[config=Debug] = Textual Dev
TEXTUAL_BUNDLE_DISPLAY_NAME = Textual IRC Client
TEXTUAL_BUNDLE_DISPLAY_NAME[config=Debug] = Textual Dev

// It is important to preserve symbols and code that is
// not directly used so that extensions can use them.

DEAD_CODE_STRIPPING = NO
GCC_SYMBOLS_PRIVATE_EXTERN = NO
STRIP_STYLE = non-global

CODE_SIGN_ENTITLEMENTS = ${PROJECT_DIR}/Supporting Files/Standard Release.entitlements
CODE_SIGN_ENTITLEMENTS[config=App Store] = ${PROJECT_DIR}/Supporting Files/App Store.entitlements

// The App Store build neither links nor embeds Sparkle.
EXCLUDED_SOURCE_FILE_NAMES[config=App Store] = Sparkle.framework
