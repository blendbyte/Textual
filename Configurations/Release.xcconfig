// Release configuration: the direct download (Sparkle, licence manager).

#include "Base.xcconfig"

TEXTUAL_BUNDLE_IDENTIFIER = com.textualapp.app
TEXTUAL_GROUP_CONTAINER_IDENTIFIER = FANJ7JNLP5.com.textualapp.app
TEXTUAL_BUILD_SCHEME_TOKEN = devid

// Feature flags, written to FeatureFlags.h by Scripts/UpdateFeatureFlags.sh.
// They only include or leave out code; they add no resources.
TEXTUAL_BUILT_INSIDE_SANDBOX=1
TEXTUAL_BUILT_WITH_LICENSE_MANAGER=1
TEXTUAL_BUILT_WITH_SPARKLE_ENABLED=1
