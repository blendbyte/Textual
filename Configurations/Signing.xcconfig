// Code signing used by all projects.
//
// Builds are signed with Blendbyte's Apple Development certificate;
// release archives are exported with Developer ID
// (Packaging/ExportArchiveConfiguration.plist).
//
// To build without Blendbyte's certificates, create
// Configurations/Signing.local.xcconfig (ignored by git), e.g.:
//
//     CODE_SIGN_IDENTITY = -
//     DEVELOPMENT_TEAM =

CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = FANJ7JNLP5
PROVISIONING_PROFILE_SPECIFIER =

#include? "Signing.local.xcconfig"
