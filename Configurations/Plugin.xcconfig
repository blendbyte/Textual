// The bundled plugins. Set on their targets. The nested xcodebuild calls in
// Scripts/BuildExtensions.sh pass the app's location and binary and build
// into the app's products folder, where the frameworks and the generated
// headers are.

// TEXTUAL_WORKSPACE_DIR is replaced by the build script
TEXTUAL_WORKSPACE_DIR = ${PROJECT_DIR}/../..

CODE_SIGN_ENTITLEMENTS = ${TEXTUAL_WORKSPACE_DIR}/Configurations/Sandbox/Inherited.entitlements

HEADER_SEARCH_PATHS = ${inherited} "${TEXTUAL_GENERATED_DIR}/Build Headers/" "${TEXTUAL_WORKSPACE_DIR}/App/SDK"
FRAMEWORK_SEARCH_PATHS = ${inherited} "${TEXTUAL_WORKSPACE_DIR}/Frameworks/Vendor/Sparkle"

WRAPPER_EXTENSION = bundle

PROVISIONING_PROFILE =
PROVISIONING_PROFILE_SPECIFIER =

BUNDLE_LOADER = ${TEXTUAL_PRODUCT_BINARY}
